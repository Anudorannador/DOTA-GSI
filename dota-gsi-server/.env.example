# Dota 2 Sidecar Listener Configuration (example)
# Copy to .env and fill in your values

# Required. Must match gamestate_integration_*.cfg. openssl rand -hex 32
# The server refuses an empty value, YOUR_PRIVATE_TOKEN, and the old public default.
GSI_AUTH_TOKEN=YOUR_PRIVATE_TOKEN

# Redis publish is OFF by default. Set REDIS_URL to enable.
# REDIS_URL=redis://user:pass@localhost:6379
REDIS_CHANNEL=dota2:gsi:live

# HTTP server configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3005

# Raw data storage directory (for JSONL logs)
RAW_DATA_DIR=./raw
RAW_MAX_MB=100
